# Юнит пользовательского уровня: systemctl --user, не системный.
#
# Демон работает с видеокартой и с сессией пользователя — ему нужны и переменные
# сессии, и доступ к /dev/nvidia*, и домашний каталог с токеном и кэшем. Системный
# юнит пришлось бы городить с User=, окружением и правами; пользовательский
# получает всё это по построению.
#
# Установка:
#   systemctl --user enable --now ~/Work/yt-trans/packaging/yt-trans.service
# Журнал:
#   journalctl --user -u yt-trans -f

[Unit]
Description=yt-trans — субтитры к роликам YouTube локальными моделями
# Ждать сети на старте незачем: сам демон никуда не ходит, пока из браузера
# не придёт задание, а к тому моменту сеть давно поднята.

# Сдаться, если он падает на старте раз за разом. Умолчание systemd — пять
# попыток за десять секунд — при RestartSec=3 не срабатывает НИКОГДА: четыре
# попытки занимают двенадцать секунд и в окно не помещаются. Ошибка в конфиге
# (демон намеренно падает на старте, а не через минуту посреди задания) крутилась
# бы вечно, а systemctl status показывал бы бодрое activating вместо failed —
# и настоящая причина пряталась бы в журнале под сотней одинаковых трассировок.
StartLimitIntervalSec=60
StartLimitBurst=4

[Service]
Type=exec
WorkingDirectory=%h/Work/yt-trans
ExecStart=%h/Work/yt-trans/.venv/bin/python -W ignore -m helper.app

# Иначе Python буферизует вывод блоками, раз он идёт не в терминал: journalctl -f
# молчал бы минутами и вываливал всё разом, ровно тогда, когда лог нужен живым.
Environment=PYTHONUNBUFFERED=1

# Демон падать не должен, но если упал — поднять. Не Restart=always: чистый выход
# по SIGTERM это остановка по команде, и перезапускать её значит не уметь остановить.
Restart=on-failure
RestartSec=3

# Остановка гасит всю группу процессов, а не только питон, — так стоит по умолчанию,
# и здесь это существенно: распознавание живёт в отдельном короткоживущем процессе
# и держит около 6 ГБ видеопамяти. Переживи он остановку демона, память не вернулась
# бы никому: сторож, который её отпускает, уже мёртв. Запас времени — чтобы успеть
# отдать карту и дописать кэш до того, как systemd перейдёт к SIGKILL.
TimeoutStopSec=30

[Install]
WantedBy=default.target
